# Copy to terraform.tfvars and fill in.
# terraform.tfvars is gitignored — never commit it (contains key names, IDs).

region            = "us-east-1"
availability_zone = "us-east-1a"

# Leave empty to auto-select the latest NixOS 26.05 x86_64 AMI.
ami_id = ""

instance_type  = "t3.small"
spot_max_price = "0.0253"

# Name of an existing EC2 key pair (created via AWS Console or `aws ec2 create-key-pair`).
key_name = "my-key-pair"

# Local private key matching key_name, used by nixos-rebuild to SSH in.
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH down to your IP. Find it with: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "0.0.0.0/0"

root_volume_size_gb = 40

domain = "tiles.perrygeo.com"

# ARN of an ACM certificate in us-east-1 for the domain above.
# Create via: AWS Console → Certificate Manager → Request → DNS validation
# The validation CNAME must be added to your DNS registrar before the cert will issue.
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"
